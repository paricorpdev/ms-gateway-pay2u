    {
      "name": "Merchant Management",
      "description": "Admin endpoints for dynamic merchant onboarding, API key issuance, key rotation, and webhook configuration. Requires Master Admin Key.",
      "item": [
        {
          "name": "Create Merchant (Localoka V2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "var data = json.response_data || json.data;",
                  "if (data && data.id) {",
                  "    pm.environment.set('merchant_id', data.id);",
                  "    pm.environment.set('merchant_api_key', data.api_key);",
                  "    pm.environment.set('api_key', data.api_key);",
                  "}",
                  "if (data && data.code) {",
                  "    pm.environment.set('merchant_code', data.code);",
                  "}",
                  "if (data && data.webhook_url) {",
                  "    pm.environment.set('merchant_webhook_url', data.webhook_url);",
                  "}",
                  "if (data && data.webhook_secret) {",
                  "    pm.environment.set('merchant_webhook_secret', data.webhook_secret);",
                  "}",
                  "if (data && data.api_key) {",
