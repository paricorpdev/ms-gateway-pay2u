          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/ready",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health",
            "ready"
          ]
        },
        "description": "Readiness probe endpoint checking downstream dependencies (PostgreSQL database and Redis cache)."
      },
      "response": []
