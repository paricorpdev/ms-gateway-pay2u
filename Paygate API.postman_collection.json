    {
      "name": "Payments (Create)",
      "description": "Endpoints for initiating new payment transactions across supported payment methods (Virtual Account, QRIS, Credit Card) with replay protection via X-Request-Id.",
      "item": [
        {
          "name": "Create VA Payment (VA-MITRA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "var data = jsonData.response_data || jsonData.data;",
                  "if (data && data.id) {",
                  "    pm.environment.set('payment_id', data.id);",
                  "    pm.environment.set('merchant_reff', data.merchant_reff);",
                  "    pm.environment.set('payment_code', data.payment_code);",
                  "    pm.environment.set('last_request_id', pm.variables.get('dynamic_request_id'));",
                  "    console.log('Saved payment_id:', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{dynamic_request_id}}"
              },
              {
                "key": "X-Service-Name",
                "value": "internal-pos-app"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant_reff\": \"{{dynamic_merchant_reff}}\",\n  \"payment_method\": \"VA-MITRA\",\n  \"bill_title\": \"Order #1001 Payment\",\n  \"bill_description\": \"Pembelian Paket Belanja\",\n  \"customer_name\": \"Budi Santoso\",\n  \"customer_phone\": \"081234567890\",\n  \"customer_email\": \"budi@example.com\",\n  \"amount\": 50000,\n  \"expired_minutes\": 1440\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": [
                "{{base_url}}"
