                  "});",
                  "var jsonData = pm.response.json();",
                  "var data = jsonData.response_data || jsonData.data;",
                  "pm.test('Returns identical transaction ID', function () {",
                  "    pm.expect(data.id).to.eql(pm.environment.get('payment_id'));",
                  "});"
